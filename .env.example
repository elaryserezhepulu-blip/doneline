# Copy to .env and fill in. Restart the server after editing.

PORT=7070
# Public address of the site (used in email links, sitemap, canonical URL)
BASE_URL=http://localhost:7070

# Shown on the public landing page & in search results (put your name here to be found by it)
SITE_NAME=Doneline
SITE_TAGLINE=Write it down. Get it done.

# --- Gmail sending (reminders + daily digest) ---
# 1) Turn on 2-Step Verification for your Google account
# 2) Create an App Password: https://myaccount.google.com/apppasswords
GMAIL_USER=
GMAIL_APP_PASSWORD=

# Optional: fixed first-time setup code (otherwise a random one is printed in the console)
# SETUP_CODE=123456

# Optional: where the database lives (point to a persistent disk when hosting)
# DATA_DIR=./data
