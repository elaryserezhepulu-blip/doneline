# Copy to .env for local use. On Render, set these in the dashboard instead.

PORT=7070
# Public address (Render sets RENDER_EXTERNAL_URL automatically, so this is optional there)
# BASE_URL=https://doneline.onrender.com

# Shown on the public landing page & in search results
SITE_NAME=Doneline
SITE_TAGLINE=Write it down. Get it done.

# --- Database ---
# Empty = local SQLite file in ./data. Set to a Postgres URL (e.g. Neon free tier) for hosting.
# DATABASE_URL=postgresql://user:pass@ep-xxx.neon.tech/neondb?sslmode=require

# --- Email (pick one; otherwise emails are only saved in Settings → Recent emails) ---
# A) Brevo HTTPS API — works on free hosts that block SMTP (Render free). 300 emails/day free.
# BREVO_API_KEY=
# MAIL_FROM_EMAIL=you@gmail.com        (must be a verified sender in Brevo)
# B) Gmail SMTP — works locally and on paid hosts.
# GMAIL_USER=you@gmail.com
# GMAIL_APP_PASSWORD=abcd efgh ijkl mnop

# Optional: fixed first-time setup code (otherwise a random one is printed in the logs)
# SETUP_CODE=123456
